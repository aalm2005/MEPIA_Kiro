# ============================================================
# MEPIA — Variables de entorno del backend Python
# ============================================================
# Copia este archivo como `api/.env` y rellena los valores.
# NUNCA subas `api/.env` al repositorio.
#
# El archivo `.env.local` en la raíz es EXCLUSIVO del frontend
# Next.js y NO debe contener variables del backend Python.
# ============================================================

# ── LLMs ────────────────────────────────────────────────────
# Usa keys distintas para dev y prod.
# N11 Consultor → Anthropic (primario) + OpenAI (fallback)
# N13, S4, N05  → OpenAI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Supabase ─────────────────────────────────────────────────
# Usa la SERVICE ROLE KEY (no la anon key).
# El backend necesita privilegios absolutos (bypass RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Entorno ──────────────────────────────────────────────────
# Valores válidos: "dev" | "prod"
ENVIRONMENT=dev
